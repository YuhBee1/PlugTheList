# Copy to secrets/.env (this folder is OUTSIDE every web root). chmod 600.
APP_ENV=production
BASE_DOMAIN=plugthelist.com
COOKIE_DOMAIN=.plugthelist.com
URL_SCHEME=https

APP_ROUTING_MODE=
APP_BASE_URL=

# 32+ random bytes, base64.  Generate: php -r "echo base64_encode(random_bytes(32)),PHP_EOL;"
# NEVER change it after launch: it protects 2FA secrets and bank account numbers.
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

PAYSTACK_SECRET=sk_live_xxx
# Optional: only accept webhooks from these IPs (Paystack's published list), comma separated
PAYSTACK_IPS=

# Long random string for the HTTP cron fallback. CLI cron needs no token.
CRON_TOKEN=

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@plugthelist.com
MAIL_FROM_NAME=PlugTheList

SUPPORT_EMAIL=support@plugthelist.com
PRIVACY_EMAIL=privacy@plugthelist.com
COMPANY_NAME=Paramount Digital Services
COMPANY_ADDRESS=Uyo, Akwa Ibom State, Nigeria
# Show the "draft" banner on legal pages until a lawyer signs off, then set to 0
LEGAL_DRAFT=1

# Only if you proxy through Cloudflare and lock the origin to Cloudflare IPs
TRUST_CLOUDFLARE=0
